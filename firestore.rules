rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user matches the userId field
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Decks collection
    match /decks/{deckId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.isPublic == true
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Cards collection
    match /cards/{cardId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/decks/$(resource.data.deckId)).data.isPublic == true
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User Stats collection
    match /user_stats/{userId} {
      // Allow any authenticated user to read (for leaderboard)
      // Only allow owner to write/update their own stats
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      match /activity/{activityId} {
         allow read, write: if isOwner(userId);
      }
    }
  }
}
